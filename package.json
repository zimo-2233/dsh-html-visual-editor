{
  "name": "dsh-html-visual-editor",
  "version": "0.1.1",
  "description": "Edit generated HTML directly in the rendered page inside the DSH sidebar, with isolated rendering, explicit saves and mtime conflict protection.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "html",
    "visual-editor",
    "wysiwyg",
    "sidebar",
    "report"
  ],
  "homepage": "https://github.com/zimo-2233/dsh-html-visual-editor#readme",
  "bugs": {
    "url": "https://github.com/zimo-2233/dsh-html-visual-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zimo-2233/dsh-html-visual-editor.git"
  },
  "author": "Cheng Rihui <zimo-2233@users.noreply.github.com>",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src/engine.js",
    "src/viewer.js",
    "cordis.patch.yml",
    "screenshots.json",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.28.0 <0.29.0",
    "react": "^18.2.0"
  },
  "dependencies": {
    "parse5": "7.3.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsdom": "26.1.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-isolation=none test/engine.test.mjs test/bootstrap-regression.test.mjs && node test/viewer.test.cjs && node test/bundle.test.cjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
